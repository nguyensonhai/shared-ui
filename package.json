  "description": "UI pieces shared by Solavi and Montide (Next.js + MUI): scramble text, inline script, emotion registry, motion helpers, UI preferences store.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyensonhai/shared-ui.git"
  },
