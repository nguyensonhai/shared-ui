  },
  "devDependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.30.2"
